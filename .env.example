# Copy this file to `.env` and fill in what you need. Everything is optional.

# Which AI runs the analysis: auto | claude | groq | offline
# auto = Claude if ANTHROPIC_API_KEY is set, else Groq if GROQ_API_KEY is set, else offline demo mode.
PP_PROVIDER=auto

# --- Claude (Anthropic) --------------------------------------------------
ANTHROPIC_API_KEY=
# Only needed if your key is organisation-level (not created inside a workspace).
# Find the ID (starts with wrkspc_) under Settings → Workspaces in the Anthropic Console.
ANTHROPIC_WORKSPACE_ID=
PP_MODEL=claude-opus-5-5

# --- Groq (open-weight models; free tier available at console.groq.com) ---
GROQ_API_KEY=
# Any Groq model that supports tool use, e.g. openai/gpt-oss-120b, llama-3.3-70b-versatile
PP_GROQ_MODEL=openai/gpt-oss-120b

# How hard the model thinks: low | medium | high (Claude also accepts xhigh | max). "none" to omit.
PP_EFFORT=medium

# Agent limits
PP_MAX_TURNS=16
PP_MAX_VERIFY_RETRIES=2
# Reroute to a fallback model if the main model declines a request (on | off)
PP_REFUSAL_FALLBACK=on

# Search: embedder auto | fastembed | hashing ; rerank auto | on | off
PP_EMBEDDER=auto
PP_EMBED_MODEL=BAAI/bge-small-en-v1.5
PP_RERANK=auto
PP_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Meaning search: exact (scan every clause) or vecdex (HNSW graph search; needs
# pip install git+https://github.com/vik-bit/vecdex)
PP_DENSE_BACKEND=exact

# Where policies, regulations, the index and saved runs live
# PP_DATA_DIR=./data

# Public demo: "on" turns off policy uploads
PP_READ_ONLY=off
